{
  "name": "@jira-workbench/core",
  "version": "0.33.7",
  "type": "module",
  "description": "Host-agnostic Jira/JXL/SVN business core shared by the Codex adapter and the DSH adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzj555/jira-workbench.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/yzj555/jira-workbench#readme",
  "bugs": {
    "url": "https://github.com/yzj555/jira-workbench/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jira-workbench-core": "bin/serve.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./index.mjs": "./index.mjs",
    "./tools.mjs": "./tools.mjs",
    "./config-store.mjs": "./config-store.mjs",
    "./jira-client.mjs": "./jira-client.mjs",
    "./jxl-client.mjs": "./jxl-client.mjs",
    "./lib/*.mjs": "./lib/*.mjs",
    "./mcp/*.mjs": "./mcp/*.mjs",
    "./public/*.js": "./public/*.js",
    "./mcp/ui/*.html": "./mcp/ui/*.html"
  },
  "scripts": {
    "serve": "node bin/serve.mjs"
  },
  "files": [
    "bin/**/*.mjs",
    "*.mjs",
    "lib/**/*.mjs",
    "mcp/**/*.mjs",
    "mcp/ui/*.html",
    "public/**/*.js"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
